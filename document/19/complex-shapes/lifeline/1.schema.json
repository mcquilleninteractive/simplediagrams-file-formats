                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "complex_shape": {
            "properties": {
              "settings": {
                "properties": {
                  "head_style": { "const": "actor" },
                  "ends_in_destroy_mark": { "const": false }
                }
              }
