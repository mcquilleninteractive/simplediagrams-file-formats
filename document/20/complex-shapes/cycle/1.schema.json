{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplediagrams.com/schemas/document/20/complex-shapes/cycle/1.schema.json",
  "title": "SimpleDiagrams document format 20 complex shape catalogue: cycle, version 1",
  "description": "The cycle complex shape at version 1: steps round a circle. An element of document.json whose complex_shape has type cycle and version 1 must pass this schema as well as document.schema.json. It holds what this entry declares, as far as JSON Schema can: its settings with their kinds, ranges and words, its roles with their counts and the keys each role's parts hold, and what it allows of its element, such as flips. The README.md beside this file states every rule, including those this schema cannot check, such as the order of the roles. This entry stays as it is for the rest of document format 20; what the type holds changes only with a later document format.",
  "type": "object",
  "required": ["complex_shape"],
  "properties": {
    "complex_shape": {
      "required": ["type", "version", "settings", "parts"],
      "properties": {
        "type": { "const": "cycle" },
        "version": { "const": 1 },
        "settings": {
          "required": ["ring_width", "direction", "arrow_style"],
          "additionalProperties": false,
          "properties": {
            "ring_width": { "type": "number", "minimum": 10, "maximum": 10000, "multipleOf": 10 },
            "direction": { "enum": ["clockwise", "anticlockwise"] },
            "arrow_style": { "enum": ["arrow", "chevron"] }
          }
        },
        "parts": {
          "minItems": 3,
          "maxItems": 8,
          "items": {
            "properties": { "role": { "enum": ["step"] } },
            "allOf": [
              {
                "if": { "properties": { "role": { "const": "step" } } },
                "then": {
                  "required": ["role", "id", "text", "point_ids"],
                  "propertyNames": {
                    "enum": ["role", "id", "text", "point_ids", "text_layout", "style"]
                  },
                  "properties": {
                    "text": {
                      "type": "object",
                      "properties": { "string": { "maxLength": 500 } }
                    },
                    "point_ids": { "minItems": 1, "maxItems": 1 }
                  }
                }
              }
            ]
          },
          "allOf": [
            {
              "contains": { "properties": { "role": { "const": "step" } } },
              "minContains": 3,
              "maxContains": 8
            }
          ]
        }
      },
      "not": { "anyOf": [{ "required": ["members"] }, { "required": ["own_text_layout"] }] }
    },
    "content": {
      "properties": {
        "flip_horizontal": { "const": false },
        "flip_vertical": { "const": false },
        "preserves_aspect_ratio": { "const": false },
        "content": {
          "properties": {
            "content": {
              "properties": {
                "text_content": {
                  "properties": {
                    "string": {
                      "description": "This type has no text of its own, so the element's text is empty.",
                      "const": ""
                    }
                  }
                },
                "connection_points": {
                  "description": "This type places its own connection points, worked out as the document is read, so the element lists none.",
                  "maxItems": 0
                }
              }
            }
          }
        }
      }
    }
  }
}
